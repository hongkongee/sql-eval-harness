# keyword_ext_eval 전용 설정. 쓰려면 복사해서 값을 채운다: cp .env.example .env
# (.env는 .gitignore 처리됨. 셸에서 export한 값이 있으면 그쪽이 우선)
# 형식: KEY=VALUE, '#' 주석, 값 앞뒤 따옴표 허용, 한 줄 값 안의 리터럴 \n은 줄바꿈으로 바뀜

# ── 키워드 추출 API (기준점) ──
KEYWORD_API_URL=http://localhost:8001
# API가 실제로 쓰는 사전 해시·설정을 docker exec로 읽을 컨테이너
KEYWORD_API_CONTAINER=gliner-entity-router-keyword-extraction-1
# 서비스 레포 / 사전 위치 (기본값이면 비워 둬도 됨, 경로는 keyword_ext_eval 기준 상대경로 가능)
# KEYWORD_SERVICE_DIR=../../../gliner-entity-router
# SCHEMA_KEYWORDS_PATH=../../../gliner-entity-router/app/config/schema_keywords.yaml

# ── zero-shot GLiNER 기준선 (gliner-entity-router의 /extract 하네스) ──
# :8000 = entity-router (urchade/gliner_multi-v2.1), :8002 = entity-router-biomed
GLINER_EXTRACT_URL=http://localhost:8000

# ── 개발서버 Qwen (OpenAI 호환 /v1/chat/completions) ──
# 요청 URL = {QWEN_BASE_URL}/chat/completions  (끝이 /chat/completions면 그대로 씀)
QWEN_BASE_URL=http://<서버 IP>:<포트>/v1
# vLLM의 served model name. 모델이 바뀌면 여기만 바꾸면 된다 (결과 파일은 모델별로 따로 두는 것을 권장:
#   make extract-qwen QWEN_OUT=eval/outputs/qwen_<모델>.jsonl)
QWEN_MODEL=Flash-Next-FP8
# 인증이 필요하면 (Authorization: Bearer ...)
QWEN_API_KEY=

# 시스템 프롬프트: 파일(여러 줄 가능) 또는 한 줄 값. 파일이 우선.
# 확정 전까지 임시 파일을 쓴다 - 확정되면 파일 내용을 교체하거나 경로를 바꿀 것.
QWEN_SYSTEM_PROMPT_FILE=eval/prompts/qwen_system_temp.txt
# QWEN_SYSTEM_PROMPT=당신은 ...\n...
# 작업 프롬프트(지시·예시·{text}). 기본값이면 비워 둬도 됨
# QWEN_PROMPT_FILE=eval/prompts/qwen_schema_keywords.txt

# 요청 옵션
QWEN_MAX_TOKENS=512
QWEN_TIMEOUT=60
QWEN_MAX_RETRIES=4
QWEN_CONCURRENCY=4
# 요청 본문에 그대로 합칠 추가 필드(JSON). 예: 추론 모델의 thinking 끄기
# QWEN_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# ── 운영 LLM 키워드 추출 (프롬프트 기반, v1/v2 API와 비교할 기준선) ──
# 개발서버 Qwen(QWEN_*, 평가용 작업 프롬프트)과 별개. 운영 시스템 프롬프트를 그대로 보낸다.
# 실행: python -m eval.csv_keyword_eval extract --system prod-llm --csv <정답 CSV> --out eval/outputs/kw50_prod_llm.jsonl
# OpenAI 호환 엔드포인트. 요청 URL = {PROD_LLM_BASE_URL}/chat/completions (끝이 /chat/completions면 그대로 씀)
PROD_LLM_BASE_URL=http://<운영 LLM 주소>:<포트>/v1
PROD_LLM_MODEL=<served model name>
PROD_LLM_API_KEY=
# 운영 시스템 프롬프트. 파일(여러 줄)이 우선, 없으면 한 줄 값.
# *.local.txt는 .gitignore 처리돼 있어 운영 프롬프트가 레포에 올라가지 않는다.
PROD_LLM_SYSTEM_PROMPT_FILE=eval/prompts/prod_llm_system.local.txt
# PROD_LLM_SYSTEM_PROMPT=당신은 ...\n...
# 사용자 메시지 템플릿. 운영에서 질의를 감싸는 문구가 있으면 그대로 옮긴다 ({text} = 질의)
PROD_LLM_USER_TEMPLATE={text}
# 요청 옵션 (운영과 같게 맞출 것)
PROD_LLM_TEMPERATURE=0
PROD_LLM_MAX_TOKENS=1024
PROD_LLM_TIMEOUT=60
PROD_LLM_MAX_RETRIES=4
# PROD_LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

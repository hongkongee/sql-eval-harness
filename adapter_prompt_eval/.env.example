# adapter_prompt_eval/run_eval.py 전용 설정.
# 실제로 쓰려면 이 파일을 .env로 복사: cp .env.example .env (.env는 이미 .gitignore 처리됨)
#
# ../.env(공용 — eval_api_model.py/eval_api_model_rag.py가 쓰는 LLM_API_URL,
# SANDBOX_DB_* 등)와는 별도 파일이다. SANDBOX_DB_*(샌드박스 DB 실행검증/EX용)는
# 이 도구도 그대로 재사용하지만, 그건 DB 하나를 가리키는 공용 설정이라 ../.env에
# 그대로 둔다 — 여기엔 "이 평가 전용" 설정(어떤 vLLM 서버에 어떤 체크포인트가
# 떠 있는지)만 둔다. ../.env도 cp해서 채워뒀는지 확인할 것.

# ── 원격 vLLM 서버 (automl-llm/scripts/serve_vllm.sh로 베이스 모델 + 체크포인트
#    여러 개를 --enable-lora로 동시에 띄워둔 서버의 주소) ──
# 최종 요청 URL은 http://{VLLM_HOST}:{VLLM_PORT}/v1/chat/completions로 조립된다.
VLLM_HOST=10.1.1.69
VLLM_PORT=8007

# ── serve_vllm.sh가 등록한 체크포인트별 served model 이름 ──
# (automl-llm/scripts/serve_vllm.sh가 쓰는 기본 이름: by-loss/final-step/by-adherence)
# --adapter를 CLI에서 하나도 안 주면 이 중 값이 채워진 것만 자동으로 테스트한다.
CHECKPOINT_EVAL_LOSS=by-loss
CHECKPOINT_CONCEPT_ID=by-adherence
CHECKPOINT_FINAL_STEP=final-step

# ── 베이스 모델(파인튜닝 전) 자체의 served model 이름 ──
# serve_vllm.sh가 --served-model-name "$STUDY_NAME"으로 등록해둔 이름
# (automl-llm/.env의 STUDY_NAME과 같은 값). 체크포인트들과 나란히 baseline으로
# 자동 비교된다 — 빼고 싶으면 --no-base로 끄거나 이 값을 비워둘 것.
BASE_MODEL_NAME=llm-finetune-study

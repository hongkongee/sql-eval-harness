-DD]\n    - device_exposure_end_datetime (기기 노출 종료 일시) datetime  [형식: YYYY-MM-DD 23:59:59]\n    - device_type_concept_id (기기 유형 개념 ID) integer  [→concept]\n    - quantity (수량) integer\n    - visit_occurrence_id (방문 발생 ID) integer  [→visit_occurrence]\n    - device_source_value (기기 원천값) varchar(50)\n    - device_source_concept_id (기기 원천 개념 ID) integer  [→concept]\n  # drug_exposure(약물 노출) PK=drug_exposure_id\n    - drug_exposure_id (약물 노출 ID) integer  [PK]\n    - person_id (환자 ID) integer  [→person]\n    - drug_concept_id (약물 개념 ID) integer  [→concept]\n    - drug_exposure_start_date (약물 노출 시작 일자) date  [형식: YYYY-MM-DD]\n    - drug_exposure_start_datetime (약물 노출 시작 일시) datetime  [형식: YYYY-MM-DD 00:00:00]\n    - drug_exposure_end_date (약물 노출 종료 일자) date  [형식: YYYY-MM-DD]\n    - drug_exposure_end_datetime (약물 노출 종료 일시) datetime  [형식: YYYY-MM-DD 23:59:59]\n    - drug_type_concept_id (약물 유형 개념 ID) integer  [→concept]\n    - quantity (수량) float\n    - days_supply (공급 일수) integer\n    - visit_occurrence_id (방문 발생 ID) integer  [→visit_occurrence]\n    - drug_source_concept_id (약물 원천 개념 ID) integer  [→concept]\n  # person(환자) PK=person_id\n    - person_id (환자 ID) integer  [PK]\n    - gender_concept_id (성별 개념 ID) integer  [→concept]\n        · 허용값: 8507=남성(MALE), 8532=여성(FEMALE)\n    - birth_datetime (출생 일시) datetime  [형식: YYYY-MM-DD 00:00:00]\n    - race_concept_id (인종 개념 ID) integer  [→concept]\n        · 허용값: 38003585=한국인(Korean), 8522=기타 인종(Other Race)\n  # procedure_occurrence(시술 발생) PK=procedure_occurrence_id\n    - procedure_occurrence_id (시술 발생 ID) integer  [PK]\n    - person_id (환자 ID) integer  [→person]\n    - procedure_concept_id (시술 개념 ID) integer  [→concept]\n    - procedure_date (시술 일자) date  [형식: YYYY-MM-DD]\n    - procedure_datetime (시술 일시) datetime  [형식: YYYY-MM-DD 00:00:00]\n    - procedure_type_concept_id (시술 유형 개념 ID) integer  [→concept]\n    - quantity (수량) integer\n    - visit_occurrence_id (방문 발생 ID) integer  [→visit_occurrence]\n    - procedure_source_
{
 "qid": "val_717",
 "set": "val",
 "text": "방사선치료 최초 시행일을 기준일로 하고 기준일 이전 동일 시행 이력이 없는 환자이며 유방암 진단 이력이 있는 환자.",
 "gold": "SELECT po.person_id, MIN(po.procedure_date) AS index_date FROM procedure_occurrence po WHERE po.procedure_concept_id IN (SELECT descendant_concept_id FROM concept_ancestor WHERE ancestor_concept_id IN (1242725)) AND NOT EXISTS ( SELECT 1 FROM procedure_occurrence prior_po WHERE prior_po.person_id = po.person_id AND prior_po.procedure_concept_id IN (SELECT descendant_concept_id FROM concept_ancestor WHERE ancestor_concept_id IN (1242725)) AND prior_po.procedure_date < po.procedure_date ) AND EXISTS ( SELECT 1 FROM condition_occurrence co WHERE co.person_id = po.person_id AND co.condition_concept_id IN (SELECT descendant_concept_id FROM concept_ancestor WHERE ancestor_concept_id IN (4112853)) AND co.condition_start_date <= po.procedure_date ) GROUP BY po.person_id;",
 "input": "[재료]\n개념 값 조건:\n  - \"방사선치료\" → procedure_occurrence.procedure_concept_id IN (1242725)\n  - \"유방암\" → condition_occurrence.condition_concept_id IN (4112853)\n테이블(컬럼 전체):\n  # condition_occurrence(진단 발생) PK=condition_occurrence_id\n    - condition_occurrence_id (진단 발생 ID) integer  [PK]\n    - person_id (환자 ID) integer  [→person]\n    - condition_concept_id (진단 개념 ID) integer  [→concept]\n    - condition_start_date (진단 시작 일자) date\n    - condition_start_datetime (진단 시작 일시) datetime\n    - condition_end_date (진단 종료 일자) date\n    - condition_end_datetime (진단 종료 일시) datetime\n    - condition_type_concept_id (진단 유형 개념 ID) integer  [→concept]\n    - condition_status_concept_id (진단 상태 개념 ID) integer  [→concept]\n    - visit_occurrence_id (방문 발생 ID) integer  [→visit_occurrence]\n    - condition_source_concept_id (진단 원천 개념 ID) integer  [→concept]\n  # person(환자) PK=person_id\n    - person_id (환자 ID) integer  [PK]\n    - gender_concept_id (성별 개념 ID) integer  [→concept]\n    - birth_datetime (출생 일시) datetime\n    - race_concept_id (인종 개념 ID) integer  [→concept]\n  # procedure_occurrence(시술 발생) PK=procedure_occurrence_id\n    - procedure_occurrence_id (시술 발생 ID) integer  [PK]\n    - person_id (환자 ID) integer  [→person]\n    - procedure_concept_id (시술 개념 ID) integer  [→concept]\n    - procedure_date (시술 일자) date\n    - procedure_datetime (시술 일시) datetime\n    - procedure_type_concept_id (시술 유형 개념 ID) integer  [→concept]\n    - quantity (수량) integer\n    - visit_occurrence_id (방문 발생 ID) integer  [→visit_occurrence]\n    - procedure_source_concept_id (시술 원천 개념 ID) integer  [→concept]\n조인:\n  - condition_occurrence.person_id = person.person_id\n  - procedure_occurrence.person_id = person.person_id",
 "section": "2.노출군",
 "query_type": "COHORT_EXTRACTION",
 "difficulty": "MEDIUM",
 "template": "○ 최초 ○일을 기준로 하고 기준 이전 동일 시행 이력이 없는 환자이며 ○ 진단 이력이 있는 환자.",

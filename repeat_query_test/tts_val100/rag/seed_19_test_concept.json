 "set": "eval_ready",
 "text": "신장 최초 측정일의 평균값과 84일 후 평균값의 차이를 조회.",
 "gold": "WITH index_dates AS ( SELECT m.person_id, MIN(m.measurement_date) AS index_date FROM measurement m WHERE m.measurement_concept_id IN (SELECT descendant_concept_id FROM concept_ancestor WHERE ancestor_concept_id IN (3036277)) GROUP BY m.person_id ), baseline_values AS ( SELECT i.person_id, i.index_date, AVG(m.value_as_number) AS baseline_value FROM index_dates i JOIN measurement m ON m.person_id = i.person_id AND m.measurement_concept_id IN (SELECT descendant_concept_id FROM concept_ancestor WHERE ancestor_concept_id IN (3036277)) AND m.measurement_date = i.index_date GROUP BY i.person_id, i.index_date ), followup_values AS ( SELECT i.person_id, AVG(m.value_as_number) AS followup_value FROM index_dates i JOIN measurement m ON m.person_id = i.person_id AND m.measurement_concept_id IN (SELECT descendant_concept_id FROM concept_ancestor WHERE ancestor_concept_id IN (3036277)) AND m.measurement_date = i.index_date + INTERVAL '84' DAY GROUP BY i.person_id ) SELECT b.person_id, b.index_date, b.baseline_value, f.followup_value, f.followup_value - b.baseline_value AS change_value FROM baseline_values b JOIN followup_values f ON f.person_id = b.person_id;",
 "input": "[재료]\n개념 값 조건:\n  - \"신장\" → measurement.measurement_concept_id IN (3036277)\n테이블(컬럼 전체):\n  # device_exposure(기기 노출) PK=device_exposure_id\n    - device_exposure_id (기기 노출 ID) integer  [PK]\n    - person_id (환자 ID) integer  [→person]\n    - device_exposure_start_date (기기 노출 시작 일자) date\n    - device_exposure_start_datetime (기기 노출 시작 일시) datetime\n    - device_exposure_end_date (기기 노출 종료 일자) date\n    - device_exposure_end_datetime (기기 노출 종료 일시) datetime\n    - device_type_concept_id (기기 유형 개념 ID) integer  [→concept]\n    - quantity (수량) integer\n    - visit_occurrence_id (방문 발생 ID) integer  [→visit_occurrence]\n    - device_source_value (기기 원천값) varchar(50)\n    - device_source_concept_id (기기 원천 개념 ID) integer  [→concept]\n  # measurement(검사) PK=measurement_id\n    - measurement_id (검사 ID) integer  [PK]\n    - person_id (환자 ID) integer  [→person]\n    - measurement_concept_id (검사 개념 ID) integer  [→concept]\n    - measurement_date (검사 일자) date\n    - measurement_datetime (검사 일시) datetime\n    - measurement_time (검사 시각) varchar(10)\n    - measurement_type_concept_id (검사 유형 개념 ID) integer  [→concept]\n    - value_as_number (숫자형 값) float\n    - range_low (참조 범위 하한) float\n    - range_high (참조 범위 상한) float\n    - visit_occurrence_id (방문 발생 ID) integer  [→visit_occurrence]\n    - measurement_source_concept_id (검사 원천 개념 ID) integer  [→concept]\n  # observation(관찰) PK=observation_id\n    - observation_id (관찰 ID) integer  [PK]\n    - person_id (환자 ID) integer  [→person]\n    - observation_concept_id (관찰 개념 ID) integer  [→concept]\n    - observation_date (관찰 일자) date\n    - observation_datetime (관찰 일시) datetime\n    - observation_type_concept_id (관찰 유형 개념 ID) integer  [→concept]\n    - value_as_number (숫자형 값) float\n    - visit_occurrence_id (방문 발생 ID) integer  [→visit_occurrence]\n    - observation_source_value (관찰 원천값) varchar(50)\n    - observation_source_concept_id (관찰 원천 개념 ID) integer  [→concept]\n    - unit_source_value (단위 원천값) varchar(50)\n  # person(환자) PK=person_id\n    - person_id (환자 ID) integer  [PK]\n    - gender_concept_id (성별 개념 ID) integer  [→concept]\n    - birth_datetime (출생 일시) datetime\n    - race_concept_id (인종 개념 ID) integer  [→concept]\n조인:\n  - device_exposure.person_id = person.person_id\n  - measurement.person_id = person.person_id\n  - observation.person_id = person.person_id",
 "section": "4.결과",

# scripts/eval_api_model.py, scripts/eval_api_model_rag.py가 읽는 설정.
# 실제로 쓰려면 이 파일을 .env로 복사해서 쓰면 된다 (.env는 .gitignore에 있어 커밋되지 않음).
#   cp .env.example .env

# ── 파인튜닝 LLM 추론 API (OpenAI 호환 /v1/chat/completions) ──
LLM_API_URL=http://10.1.1.69:8003/v1/chat/completions
LLM_MODEL_NAME=xiyan-sql-14b-sft-260914

# 자연어 질문만 그대로 넣는 기존 방식(eval_api_model.py 기본 모드)의 시스템 프롬프트.
# 모델이 IN절 자리에 {{개념명}} 플레이스홀더를 남기도록 학습된 전제와 맞물려 있음.
LLM_SYSTEM_PROMPT=You are a Text-to-SQL expert. Convert the following natural language query into a SQL statement based on the schema.

# ── RAG 프롬프트 조립 API ──
# POST {"text": "<자연어 질의>"} 하면 concepts/tables/joins/prompt 필드가 담긴 JSON을 응답.
# "prompt" 필드를 그대로 LLM의 user 메시지로 넣는다 (eval_api_model_rag.py).
RAG_API_URL=http://10.1.1.106:8080/materials

# RAG가 만든 [질의]/[재료] 구조 프롬프트를 LLM에 넣을 때 쓸 시스템 프롬프트.
# RAG는 이제 개념 전체가 아니라 대표(앵커) concept_id만 주므로, 모델이 항상
# concept_ancestor 서브쿼리로 하위 개념까지 확장하도록 지시한다 (리터럴 IN 금지).
# 여러 줄은 리터럴 "\n"으로 이어 한 줄로 적는다 (로더가 실제 줄바꿈으로 변환).
RAG_LLM_SYSTEM_PROMPT=당신은 OMOP CDM 기반 Text-to-SQL 전문가입니다. [질의]는 사용자의 자연어 질문이고, [재료]에는 질의에 필요한 개념(concept)의 대표(앵커) concept_id, 사용 가능한 테이블/컬럼 스키마, 테이블 간 조인 관계가 이미 정리되어 있습니다.\n\n[재료]의 concept_id는 그 개념 전체를 대표하는 상위(앵커) 코드만 주어지며, 하위(descendant) 코드는 생략되어 있습니다. 앵커 코드를 IN절에 직접 나열하면 하위 개념이 다 빠지므로 절대 그렇게 쓰면 안 되고, 반드시 concept_ancestor 테이블로 하위 개념까지 확장해서 조회하세요.\n\n다음을 반드시 지키세요:\n1. 개념 값 조건은 앵커가 몇 개든 항상 아래 형태의 서브쿼리로 쓰세요 (리터럴 IN절 절대 금지):\n   <컬럼> IN (\n     SELECT descendant_concept_id FROM concept_ancestor\n     WHERE ancestor_concept_id IN (<[재료]에 주어진 앵커 concept_id 전부>)\n   )\n2. [재료]에 나열된 테이블/컬럼만 사용하세요. 나열되지 않은 테이블/컬럼을 추측해서 만들지 마세요.\n3. [재료]의 조인 관계를 그대로 사용하세요.\n4. NOT IN절은 어떤 경우에도 사용하지 마세요. 제외 조건이 필요하면 NOT EXISTS (서브쿼리) 형태로 쓰세요.\n5. 다른 설명 없이 SQL 쿼리 하나만 답하세요.

# ── 샌드박스 PostgreSQL DB (V5 실행검증용 — 미설정 시 V5 건너뜀) ──
SANDBOX_DB_HOST=10.10.30.32
SANDBOX_DB_PORT=5434
SANDBOX_DB_NAME=postgres
SANDBOX_DB_USER=postgres
SANDBOX_DB_PASSWORD=postgres
SANDBOX_DB_TIMEOUT=30000
